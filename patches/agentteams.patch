+//! Actual v0.57 engine, public Task bridge and native RunQueue. Synthetic API/provider only.
+use super::*;
+use crate::openhuman::agent::harness::run_queue::{QueueMode, QueuedMessage, RunQueue};
+use crate::openhuman::channels::{task_protocol as native, task_telemetry, traits::ChannelMessage};
+use crate::openhuman::inference::provider::{ChatRequest, ChatResponse, Provider, UsageInfo};
+use crate::openhuman::tools::implementations::{FileReadTool, FileWriteTool, ShellTool};
+use crate::openhuman::tools::{Tool, ToolResult};
+use async_trait::async_trait;
+use serde_json::json;
+use std::io::{Read, Write};
+use std::sync::{
+    atomic::{AtomicBool, AtomicUsize, Ordering},
+    Arc, Mutex,
+};
+use tokio::sync::Notify;
+
+const PRIVATE: &str = "OWN_PRIVATE_TASK_INPUT_a487";
+struct Model(AtomicUsize);
+#[async_trait]
+impl Provider for Model {
+    async fn chat_with_system(
+        &self,
+        _: Option<&str>,
+        _: &str,
+        _: &str,
+        _: f64,
+    ) -> anyhow::Result<String> {
+        unreachable!()
+    }
+    async fn chat(
+        &self,
+        request: ChatRequest<'_>,
+        _: &str,
+        _: f64,
+    ) -> anyhow::Result<ChatResponse> {
+        let text = match self.0.fetch_add(1, Ordering::SeqCst) {
+            0 => {
+                assert!(request
+                    .messages
+                    .iter()
+                    .any(|row| row.content.contains(PRIVATE)));
+                "<tool_call>{\"name\":\"wait_for_supplements\",\"arguments\":{}}</tool_call>"
+            }
+            1 => {
+                let contents = request
+                    .messages
+                    .iter()
+                    .map(|row| row.content.as_str())
+                    .collect::<Vec<_>>()
+                    .join("\n");
+                assert!(contents.contains("native tool finished"));
+                assert!(
+                    contents.find("first supplement").unwrap()
+                        < contents.find("second supplement").unwrap()
+                );
+                "<tool_call>{\"name\":\"task\",\"arguments\":{\"action\":\"submit\",\"taskId\":\"native-exec\",\"summary\":\"OWN_PRIVATE_TASK_INPUT_a487\"}}</tool_call>"
+            }
+            _ => panic!(
+                "Public terminal receipt must end the native phase without another model request"
+            ),
+        };
+        Ok(ChatResponse {
+            text: Some(text.into()),
+            usage: Some(UsageInfo {
+                input_tokens: 11,
+                output_tokens: 3,
+                cached_input_tokens: 2,
+                ..UsageInfo::default()
+            }),
+            ..ChatResponse::default()
+        })
+    }
+}
+struct WaitTool {
+    started: Arc<Notify>,
+    release: Arc<Notify>,
+}
+#[async_trait]
+impl Tool for WaitTool {
+    fn name(&self) -> &str {
+        "wait_for_supplements"
+    }
+    fn description(&self) -> &str {
+        "Wait inside the actual native executor"
+    }
+    fn parameters_schema(&self) -> serde_json::Value {
+        json!({"type":"object"})
+    }
+    async fn execute(&self, _: serde_json::Value) -> anyhow::Result<ToolResult> {
+        self.started.notify_one();
+        self.release.notified().await;
+        Ok(ToolResult::success("native tool finished"))
+    }
+}
+
+#[tokio::test]
+async fn agentteams_native_task_protocol_and_steering_keep_receipts_io_budget_and_traces() {
+    let root = tempfile::tempdir().unwrap();
+    let plugin = root.path().join("plugin/mcp/common");
+    std::fs::create_dir_all(&plugin).unwrap();
+    let script = r#"import importlib.util,json,os,sys
+from pathlib import Path
+base=Path(os.environ['AT_SOURCE'])/'plugins/teamharness/mcp/common'
+sys.path.insert(0,str(base))
+spec=importlib.util.spec_from_file_location('actual_public_native',base/'task_native.py')
+module=importlib.util.module_from_spec(spec);spec.loader.exec_module(module)
+request=json.load(sys.stdin)
+def call(arguments):
+ root=Path(os.environ['AGENTTEAMS_WORKER_HOME'])/'tasks/native-exec'
+ if arguments['action']=='begin':
+  (root/'workspace/.scratch').mkdir(parents=True,exist_ok=True)
+  return {'task':{'id':'native-exec','status':'in_progress','mainTaskId':'main','assignedTo':'one','assignmentId':'dispatch'},'taskDirectory':str(root),'outputDirectory':str(root/'workspace'),'scratchDirectory':str(root/'workspace/.scratch')}
+ assert arguments['action']=='submit' and arguments['taskId']=='native-exec'
+ return {'task':{'id':'native-exec','status':'submitted','submissionId':'candidate'},'notification':{'eventId':'notice','status':'queued','recipient':'leader'}}
+async def notify(event,native,action):
+ assert event=='aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa' and native=='$native-source', 'NativePhase requires the exact original phase and raw Matrix event ID'
+ return {'active':True}
+print(json.dumps(module.invoke(request,call=call,notify=notify)))
+"#;
+    std::fs::write(plugin.join("task_native.py"), script).unwrap();
+    std::env::set_var("AGENTTEAMS_PLUGIN_DIR", root.path().join("plugin"));
+    std::env::set_var("AGENTTEAMS_WORKER_HOME", root.path());
+    std::env::set_var("AGENTTEAMS_AGENT_ROLE", "worker");
+    std::env::remove_var("AGENTTEAMS_CONTROLLER_URL");
+    let metadata = root.path().join(".agentteams");
+    std::fs::create_dir_all(&metadata).unwrap();
+    let mut schema = std::process::Command::new("python3")
+        .arg(plugin.join("task_native.py"))
+        .stdin(std::process::Stdio::piped())
+        .stdout(std::process::Stdio::piped())
+        .spawn()
+        .unwrap();
+    schema
+        .stdin
+        .take()
+        .unwrap()
+        .write_all(br#"{"operation":"schema","role":"worker"}"#)
+        .unwrap();
+    let result = schema.wait_with_output().unwrap();
+    assert!(result.status.success());
+    std::fs::write(metadata.join("native-task-schema.json"), result.stdout).unwrap();
+    let listener = std::net::TcpListener::bind("127.0.0.1:0").unwrap();
+    listener.set_nonblocking(true).unwrap();
+    std::env::set_var(
+        "OTEL_EXPORTER_OTLP_TRACES_ENDPOINT",
+        format!("http://{}/v1/traces", listener.local_addr().unwrap()),
+    );
+    std::env::set_var("AGENTTEAMS_OTEL_ENABLED", "true");
+    let stopped = Arc::new(AtomicBool::new(false));
+    let stop = stopped.clone();
+    let bodies = Arc::new(Mutex::new(Vec::new()));
+    let collected = bodies.clone();
+    let collector = std::thread::spawn(move || {
+        let deadline = std::time::Instant::now() + std::time::Duration::from_secs(30);
+        while !stop.load(Ordering::SeqCst) && std::time::Instant::now() < deadline {
+            let (mut stream, _) = match listener.accept() {
+                Ok(v) => v,
+                Err(e) if e.kind() == std::io::ErrorKind::WouldBlock => {
+                    std::thread::sleep(std::time::Duration::from_millis(10));
+                    continue;
+                }
+                Err(e) => panic!("{e}"),
+            };
+            stream
+                .set_read_timeout(Some(std::time::Duration::from_secs(10)))
+                .unwrap();
+            let mut data = vec![];
+            loop {
+                let mut buffer = [0; 4096];
+                let count = stream.read(&mut buffer).unwrap();
+                assert!(count > 0);
+                data.extend_from_slice(&buffer[..count]);
+                if let Some(offset) = data.windows(4).position(|v| v == b"\r\n\r\n") {
+                    let headers = String::from_utf8_lossy(&data[..offset]);
+                    let length: usize = headers
+                        .lines()
+                        .find_map(|line| {
+                            line.to_lowercase()
+                                .strip_prefix("content-length:")
+                                .map(|v| v.trim().parse().unwrap())
+                        })
+                        .unwrap();
+                    if data.len() >= offset + 4 + length {
+                        collected
+                            .lock()
+                            .unwrap()
+                            .extend_from_slice(&data[offset + 4..offset + 4 + length]);
+                        break;
+                    }
+                }
+            }
+            stream
+                .write_all(b"HTTP/1.1 200 OK\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
+                .unwrap();
+        }
+    });
+    native::register(
+        "$native-source",
+        json!({"teamharness_coordination":{"id":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","kind":"task_assigned","task_id":"native-exec","main_task_id":"main","project_id":"","delivery_id":"dispatch"},"otel_carrier":{"traceparent":"00-123456789012345678901234567890ab-12345678901234ab-01"}}),
+    );
+    crate::openhuman::channels::task_recovery::bind_protocol_source(
+        "$native-source",
+        &json!({
+            "task_plan_id":"plan", "task_id":"native-exec", "main_task_id":"main", "notifyTxn":"dispatch"
+        }),
+    );
+    let message = ChannelMessage {
+        id: "$native-source".into(),
+        reply_target: "!native:test".into(),
+        sender: "@leader:test".into(),
+        content: PRIVATE.into(),
+        channel: "matrix".into(),
+        timestamp: 1,
+        thread_ts: None,
+    };
+    let model = Model(AtomicUsize::new(0));
+    let finished=native::scope(&message,"opaque-native-session",async {
+        let policy=Arc::new(crate::openhuman::security::SecurityPolicy{autonomy:crate::openhuman::security::AutonomyLevel::Full,workspace_dir:root.path().join("private"),action_dir:root.path().join("native-actions"),max_actions_per_hour:3,..Default::default()});
+        std::fs::create_dir_all(&policy.workspace_dir).unwrap();std::fs::create_dir_all(&policy.action_dir).unwrap();
+        let output=native::output_directory().unwrap();
+        let write=FileWriteTool::new(policy.clone());let read=FileReadTool::new(policy.clone());
+        assert!(!write.execute(json!({"path":"answer.txt","content":PRIVATE})).await.unwrap().is_error);
+        assert_eq!(std::fs::read_to_string(output.join("answer.txt")).unwrap(),PRIVATE);
+        assert!(!read.execute(json!({"path":"answer.txt"})).await.unwrap().is_error);
+        assert!(write.execute(json!({"path":"../outside.txt","content":"bad"})).await.map(|r|r.is_error).unwrap_or(true));
+        let shell=ShellTool::new(policy.clone(),Arc::new(crate::openhuman::agent::host_runtime::NativeRuntime::new()),crate::openhuman::security::AuditLogger::disabled());
+        let pwd=shell.execute(json!({"command":"pwd"})).await.unwrap();assert!(!pwd.is_error);assert_eq!(pwd.output().trim(),output.to_str().unwrap());
+        assert!(shell.execute(json!({"command":"pwd"})).await.unwrap().is_error);
+        assert_eq!(policy.tracker.count(),3,"Task-scoped validators must never reset the native budget");
+        assert_eq!(policy.workspace_dir,root.path().join("private"));assert_eq!(policy.action_dir,root.path().join("native-actions"));
+        let queue=RunQueue::new();let started=Arc::new(Notify::new());let release=Arc::new(Notify::new());
+        let tools:Vec<Box<dyn Tool>>=vec![Box::new(WaitTool{started:started.clone(),release:release.clone()}),Box::new(native::TaskTool)];
+        let mut source=RegistryToolSource::new(&tools,&[],None,&crate::openhuman::tools::policy::DefaultToolPolicy,None);
+        let mut history=vec![crate::openhuman::inference::provider::ChatMessage::user(PRIVATE)];
+        let progress=TurnProgress::new(None);let mut observer=NullObserver;
+        let multimodal=crate::openhuman::config::MultimodalConfig::default();let files=crate::openhuman::config::MultimodalFileConfig::default();
+        let run=run_turn_engine(&model,&mut history,&mut source,&progress,&mut observer,&ErrorCheckpoint,&DefaultParser,"fixture","fixture-model",0.0,true,&multimodal,&files,4,None,&[],Some(queue.clone()));
+        tokio::pin!(run);
+        tokio::select!{_ = started.notified()=>{},_ = &mut run=>panic!("Native wait tool did not start")}
+        for text in ["first supplement","second supplement"]{
+            queue.push(QueuedMessage{text:text.into(),mode:QueueMode::Steer,client_id:text.into(),thread_id:"native-direct".into(),queued_at_ms:0,model_override:None,temperature:None,profile_id:None,locale:None}).await;
+        }
+        release.notify_one();let result=run.await.unwrap();assert!(result.text.contains("Task system receipt"));assert!(native::completed().is_some());assert_eq!(queue.status().await.total,0);
+        result.text
+    }).await.unwrap();
+    assert!(finished.contains("Task system receipt"));
+    assert_eq!(model.0.load(Ordering::SeqCst), 2);
+    tokio::task::spawn_blocking(task_telemetry::flush)
+        .await
+        .unwrap();
+    stopped.store(true, Ordering::SeqCst);
+    collector.join().unwrap();
+    let body = bodies.lock().unwrap();
+    let count = |needle: &[u8]| body.windows(needle.len()).filter(|v| *v == needle).count();
+    assert_eq!(count(b"gen_ai.chat"), 2);
+    assert_eq!(count(b"tool.execute"), 2);
+    assert_eq!(count(PRIVATE.as_bytes()), 0);
+    for marker in [
+        "agentteams.task.id",
+        "native-exec",
+        "gen_ai.usage.input_tokens",
+        "gen_ai.usage.output_tokens",
+        "$native-source",
+        "agentteams.coordination.id",
+    ] {
+        assert!(count(marker.as_bytes()) > 0, "missing {marker}");
+    }
+    let trace = [
+        0x12, 0x34, 0x56, 0x78, 0x90, 0x12, 0x34, 0x56, 0x78, 0x90, 0x12, 0x34, 0x56, 0x78, 0x90,
+        0xab,
+    ];
+    assert!(count(&trace) >= 5);
+    if let Ok(path) = std::env::var("AGENTTEAMS_NATIVE_TRACE_EVIDENCE") {
+        std::fs::write(path, &*body).unwrap();
+    }
+    println!("actual SDK engine: public Task + native steering + scoped IO + original budget + terminal receipt; 2 model calls, 2 tool calls, trusted OTLP carrier, no content; synthetic provider/API, not certification");
+}
