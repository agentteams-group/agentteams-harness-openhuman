+/// Backport of upstream #6249's caller-owned runtime authentication distinction.
+/// Limit this hosted integration to explicitly configured local-openai gateways.
+fn caller_owned_local_openai_is_configured(config: &Config, provider: &str) -> bool {
+    provider.trim().starts_with(LOCAL_OPENAI_PROVIDER_PREFIX)
+        && config.local_ai.runtime_enabled
+        && config.local_ai.opt_in_confirmed
+        && config
+            .local_ai
+            .api_key
+            .as_deref()
+            .is_some_and(|key| !key.trim().is_empty())
+}
+
+fn verify_provider_session(config: &Config, provider: &str) -> anyhow::Result<()> {
+    if caller_owned_local_openai_is_configured(config, provider) {
+        return Ok(());
+    }
+    verify_session_active(config)
+}
