+//! Native API/adapter tests; these do not replace real Controller/Matrix/model E2E.
+use openhuman_core::openhuman;
+
+#[cfg(unix)]
+#[tokio::test]
+async fn cancelled_native_mcp_call_stops_server_and_child_and_can_reinitialize() {
+    use openhuman_core::openhuman::config::McpClientIdentityConfig;
+    use openhuman_core::openhuman::mcp_client::McpStdioClient;
+    use std::sync::Arc;
+    use std::time::Duration;
+    let directory = tempfile::tempdir().unwrap();
+    let script = directory.path().join("mcp.py");
+    let pidfile = directory.path().join("pids");
+    let marker = directory.path().join("must-not-run");
+    std::fs::write(&script, r#"import sys,json,os,subprocess,pathlib
+for line in sys.stdin:
+    request=json.loads(line)
+    if request['method']=='initialize':
+        result={'protocolVersion':'2025-11-25','capabilities':{},'serverInfo':{'name':'test','version':'1'}}
+    elif request['method']=='notifications/initialized': continue
+    elif request['method']=='tools/list': result={'tools':[]}
+    else:
+        child=subprocess.Popen(['sleep','30'])
+        pathlib.Path(sys.argv[1]).write_text(str(os.getpid())+','+str(child.pid))
+        child.wait()
+        pathlib.Path(sys.argv[2]).touch()
+        result={'content':[{'type':'text','text':'unexpected'}]}
+    print(json.dumps({'jsonrpc':'2.0','id':request['id'],'result':result}),flush=True)
+"#).unwrap();
+    let client = Arc::new(McpStdioClient::new(
+        "python3".into(),
+        vec![
+            script.display().to_string(),
+            pidfile.display().to_string(),
+            marker.display().to_string(),
+        ],
+        Vec::new(),
+        None,
+        McpClientIdentityConfig::default(),
+    ));
+    let original = client.clone();
+    let call =
+        tokio::spawn(async move { original.call_tool("effect", serde_json::json!({})).await });
+    for _ in 0..200 {
+        if pidfile.exists() {
+            break;
+        }
+        assert!(
+            !call.is_finished(),
+            "native call ended before its external operation started"
+        );
+        tokio::time::sleep(Duration::from_millis(25)).await;
+    }
+    let pids: Vec<u32> = std::fs::read_to_string(&pidfile)
+        .expect("operation started")
+        .split(',')
+        .map(|s| s.parse().unwrap())
+        .collect();
+    call.abort();
+    assert!(call.await.unwrap_err().is_cancelled());
+    let running = |pid: &u32| -> bool {
+        std::process::Command::new("ps")
+            .args(["-o", "stat=", "-p", &pid.to_string()])
+            .output()
+            .ok()
+            .is_some_and(|out| {
+                let state = String::from_utf8_lossy(&out.stdout);
+                !state.trim().is_empty() && !state.trim().starts_with('Z')
+            })
+    };
+    for _ in 0..200 {
+        if !pids.iter().any(&running) {
+            break;
+        }
+        tokio::time::sleep(Duration::from_millis(25)).await;
+    }
+    assert!(
+        !pids.iter().any(running),
+        "native MCP server and its tool child must both stop"
+    );
+    assert!(!marker.exists());
+    assert!(
+        client.list_tools().await.unwrap().is_empty(),
+        "cancelled stdio session must be rebuilt"
+    );
+    client.close_session().await.unwrap();
+}
+
+#[test]
+fn gateway_routing_preserves_structured_tool_capability() {
+    use openhuman_core::openhuman::config::Config;
+    use openhuman_core::openhuman::inference::provider::{
+        create_intelligent_routing_provider, ProviderRuntimeOptions,
+    };
+
+    let mut config = Config::default();
+    config.local_ai.runtime_enabled = false;
+    let provider = create_intelligent_routing_provider(
+        Some("http://127.0.0.1:8080/v1"),
+        None,
+        Some("fixture-worker-key"),
+        &config,
+        &ProviderRuntimeOptions::default(),
+    )
+    .unwrap();
+    assert!(provider.supports_native_tools());
+}
