+use super::*;
+use crate::openhuman::agent::harness::run_queue::{QueueMode, QueuedMessage, RunQueue};
+use crate::openhuman::inference::provider::{ChatRequest, ChatResponse, Provider};
+use crate::openhuman::tools::{Tool, ToolResult};
+use async_trait::async_trait;
+use std::sync::{
+    atomic::{AtomicBool, Ordering},
+    Arc,
+};
+use tokio::sync::Notify;
+
+struct Model(AtomicBool);
+#[async_trait]
+impl Provider for Model {
+    async fn chat_with_system(
+        &self,
+        _: Option<&str>,
+        _: &str,
+        _: &str,
+        _: f64,
+    ) -> anyhow::Result<String> {
+        unreachable!()
+    }
+    async fn chat(
+        &self,
+        request: ChatRequest<'_>,
+        _: &str,
+        _: f64,
+    ) -> anyhow::Result<ChatResponse> {
+        let text = if !self.0.swap(true, Ordering::SeqCst) {
+            "<tool_call>{\"name\":\"wait_for_supplements\",\"arguments\":{}}</tool_call>"
+        } else {
+            let text = request
+                .messages
+                .iter()
+                .map(|row| row.content.as_str())
+                .collect::<Vec<_>>()
+                .join("\n");
+            assert!(text.contains("original request"));
+            assert!(text.contains("native tool finished"));
+            assert!(
+                text.find("first supplement").unwrap() < text.find("second supplement").unwrap()
+            );
+            "steered result"
+        };
+        Ok(ChatResponse {
+            text: Some(text.into()),
+            tool_calls: vec![],
+            usage: None,
+            reasoning_content: None,
+        })
+    }
+}
+
+struct WaitTool {
+    started: Arc<Notify>,
+    release: Arc<Notify>,
+}
+#[async_trait]
+impl Tool for WaitTool {
+    fn name(&self) -> &str {
+        "wait_for_supplements"
+    }
+    fn description(&self) -> &str {
+        "Wait at the native tool boundary"
+    }
+    fn parameters_schema(&self) -> serde_json::Value {
+        serde_json::json!({"type":"object"})
+    }
+    async fn execute(&self, _: serde_json::Value) -> anyhow::Result<ToolResult> {
+        self.started.notify_one();
+        self.release.notified().await;
+        Ok(ToolResult::success("native tool finished"))
+    }
+}
+
+#[tokio::test]
+async fn agentteams_native_steer_reaches_the_next_request_without_cancelling_tools() {
+    let queue = RunQueue::new();
+    let started = Arc::new(Notify::new());
+    let release = Arc::new(Notify::new());
+    let tools: Vec<Box<dyn Tool>> = vec![Box::new(WaitTool {
+        started: started.clone(),
+        release: release.clone(),
+    })];
+    let mut history = vec![crate::openhuman::inference::provider::ChatMessage::user(
+        "original request",
+    )];
+    let model = Model(AtomicBool::new(false));
+    let mut source = RegistryToolSource::new(
+        &tools,
+        &[],
+        None,
+        &crate::openhuman::tools::policy::DefaultToolPolicy,
+        None,
+    );
+    let progress = TurnProgress::new(None);
+    let mut observer = NullObserver;
+    let multimodal = crate::openhuman::config::MultimodalConfig::default();
+    let files = crate::openhuman::config::MultimodalFileConfig::default();
+    let run = run_turn_engine(
+        &model,
+        &mut history,
+        &mut source,
+        &progress,
+        &mut observer,
+        &ErrorCheckpoint,
+        &DefaultParser,
+        "fixture",
+        "fixture-model",
+        0.0,
+        true,
+        &multimodal,
+        &files,
+        3,
+        None,
+        &[],
+        Some(queue.clone()),
+    );
+    tokio::pin!(run);
+    tokio::select! {
+        _ = started.notified() => {},
+        _ = &mut run => panic!("native tool did not wait"),
+    }
+    for text in ["first supplement", "second supplement"] {
+        queue
+            .push(QueuedMessage {
+                text: text.into(),
+                mode: QueueMode::Steer,
+                client_id: text.into(),
+                thread_id: "matrix-direct".into(),
+                queued_at_ms: 0,
+                model_override: None,
+                temperature: None,
+                profile_id: None,
+                locale: None,
+            })
+            .await;
+    }
+    assert_eq!(queue.status().await.steers, 2);
+    release.notify_one();
+    assert_eq!(run.await.unwrap().text, "steered result");
+    assert_eq!(queue.status().await.total, 0);
+}
