+#[tokio::test]
+async fn dashboard_approval_round_trip_uses_native_waiter_and_committed_receipt() {
+    use crate::openhuman::approval::{matrix, ApprovalRequest, ApprovalResponse};
+    use wiremock::matchers::{header, method};
+    use wiremock::{Mock, MockServer, Request, ResponseTemplate};
+    for (action, expected, status) in [
+        ("approve", ApprovalResponse::Yes, "approved"),
+        ("deny", ApprovalResponse::No, "rejected"),
+    ] {
+        let server = MockServer::start().await;
+        Mock::given(method("PUT"))
+            .and(header("authorization", "Bearer test-token"))
+            .respond_with(move |request: &Request| {
+                let content: serde_json::Value = request.body_json().unwrap();
+                let approval = &content["org.agentteams.approval"];
+                if approval["status"] == "pending" {
+                    let body = format!(
+                        "/agentteams-approval {action} {} {}",
+                        approval["request_id"].as_str().unwrap(),
+                        approval["context_id"].as_str().unwrap()
+                    );
+                    matrix::answer("!other:test", "@owner:test", &body);
+                    matrix::answer("!room:test", "@intruder:test", &body);
+                    matrix::answer("!room:test", "@owner:test", &body);
+                }
+                ResponseTemplate::new(200).set_body_json(serde_json::json!({"event_id": "$event"}))
+            })
+            .mount(&server)
+            .await;
+        let channel = MatrixChannel::new(
+            server.uri(),
+            "test-token".into(),
+            "!room:test".into(),
+            vec!["@owner:test".into()],
+        );
+        let result = channel
+            .request_approval(
+                "!room:test",
+                "@owner:test",
+                &ApprovalRequest {
+                    tool_name: "shell".into(),
+                    arguments: serde_json::json!({"command": "printf proof"}),
+                },
+            )
+            .await;
+        assert_eq!(result, expected);
+        let requests = server.received_requests().await.unwrap();
+        assert_eq!(requests.len(), 2);
+        let pending: serde_json::Value = requests[0].body_json().unwrap();
+        let receipt: serde_json::Value = requests[1].body_json().unwrap();
+        assert_eq!(pending["org.agentteams.approval"]["status"], "pending");
+        assert_eq!(receipt["org.agentteams.approval"]["status"], status);
+        assert_eq!(
+            pending["org.agentteams.approval"]["request_id"],
+            receipt["org.agentteams.approval"]["request_id"]
+        );
+    }
