+use serde_json::json;
+
+#[tokio::test]
+async fn matrix_run_acknowledges_only_after_cleanup_and_retains_supplements() {
+    use matrix_sdk::{
+        authentication::matrix::MatrixSession, config::SyncSettings, Client, SessionMeta,
+        SessionTokens,
+    };
+    use wiremock::{
+        matchers::{method, path, path_regex},
+        Mock, MockServer, ResponseTemplate,
+    };
+    let server = MockServer::start().await;
+    Mock::given(method("GET"))
+        .and(path("/_matrix/client/versions"))
+        .respond_with(ResponseTemplate::new(200).set_body_json(json!({"versions": ["v1.13"]})))
+        .mount(&server)
+        .await;
+    Mock::given(method("GET")).and(path("/_matrix/client/v3/sync"))
+        .respond_with(ResponseTemplate::new(200).set_body_json(json!({
+            "next_batch": "cursor", "rooms": {"join": {"!dm:test": {
+                "timeline": {"events": [], "limited": false},
+                "state": {"events": [
+                    {"type": "m.room.create", "state_key": "", "sender": "@agent:test", "event_id": "$create", "origin_server_ts": 1, "content": {"creator": "@agent:test", "room_version": "10"}},
+                    {"type": "m.room.member", "state_key": "@agent:test", "sender": "@agent:test", "event_id": "$member", "origin_server_ts": 2, "content": {"membership": "join"}}
+                ]}
+            }}}
+        }))).mount(&server).await;
+    Mock::given(method("PUT"))
+        .and(path_regex(
+            "/_matrix/client/v3/rooms/.*/send/m.room.message/.*",
+        ))
+        .respond_with(ResponseTemplate::new(200).set_body_json(json!({"event_id": "$status"})))
+        .mount(&server)
+        .await;
+    Mock::given(method("GET"))
+        .and(path_regex(
+            "/_matrix/client/v3/rooms/.*/state/m.room.encryption/",
+        ))
+        .respond_with(
+            ResponseTemplate::new(404)
+                .set_body_json(json!({"errcode": "M_NOT_FOUND", "error": "Not encrypted"})),
+        )
+        .mount(&server)
+        .await;
+    let client = Client::builder()
+        .homeserver_url(server.uri())
+        .build()
+        .await
+        .unwrap();
+    client
+        .restore_session(MatrixSession {
+            meta: SessionMeta {
+                user_id: "@agent:test".try_into().unwrap(),
+                device_id: "TEST".into(),
+            },
+            tokens: SessionTokens {
+                access_token: "local-test-only".into(),
+                refresh_token: None,
+            },
+        })
+        .await
+        .unwrap();
+    client.sync_once(SyncSettings::default()).await.unwrap();
+    let room_id: matrix_sdk::ruma::OwnedRoomId = "!dm:test".try_into().unwrap();
+    let room = client.get_room(&room_id).unwrap();
+    super::register(
+        room.clone(),
+        "$original".into(),
+        "@human:test".into(),
+        vec!["原任务".into()],
+        vec!["$original".into()],
+    );
+    let original = super::get("$original").unwrap();
+    original.start().await;
+    assert_eq!(super::active("!dm:test").unwrap().sender, "@human:test");
+    assert!(original.steer("$one", "first supplement").await);
+    assert!(original.steer("$two", "second supplement").await);
+    assert!(original.steer("$one", "first supplement").await);
+    assert!(!original.cancel.is_cancelled());
+    let steers = original.queue.drain_steers().await;
+    assert_eq!(
+        steers
+            .iter()
+            .map(|message| message.text.as_str())
+            .collect::<Vec<_>>(),
+        ["first supplement", "second supplement"]
+    );
+    original.cancel.cancel();
+    assert!(
+        !original.done.is_cancelled(),
+        "request must not acknowledge cleanup"
+    );
+    original.finish().await;
+    assert!(!original.steer("$late", "late supplement").await);
+    assert!(original.done.is_cancelled());
+    assert!(super::active("!dm:test").is_none());
+    let mut inputs = original.inputs.clone();
+    inputs.push("补充杭州".into());
+    let mut source_event_ids = original.source_event_ids.clone();
+    source_event_ids.push("$supplement".into());
+    super::register(
+        room,
+        "$supplement".into(),
+        "@human:test".into(),
+        inputs,
+        source_event_ids,
+    );
+    let replacement = super::get("$supplement").unwrap();
+    replacement.start().await;
+    assert_eq!(replacement.inputs, ["原任务", "补充杭州"]);
+    assert_eq!(replacement.source_event_ids, ["$original", "$supplement"]);
+    replacement.finish().await;
+    super::super::task_protocol::register("$assistant", json!({
+        "teamharness_coordination": {"kind": "assistant_digest"}
+    }));
+    super::register(replacement.room.clone(), "$assistant".into(),
+        "@agent:test".into(), vec![], vec![]);
+    let assistant = super::get("$assistant").unwrap();
+    // The native Task scope consumes the packet before completion.
+    super::super::task_protocol::register("$assistant", json!({}));
+    assistant.start().await;
+    assistant.finish().await;
+    assert!(assistant.done.is_cancelled());
+
+    let statuses: Vec<_> = server
+        .received_requests()
+        .await
+        .unwrap()
+        .into_iter()
+        .filter_map(|request| serde_json::from_slice::<serde_json::Value>(&request.body).ok())
+        .filter_map(|body| {
+            body.pointer("/com.agentteams.execution/status")
+                .and_then(|v| v.as_str())
+                .map(str::to_owned)
+        })
+        .collect();
+    assert_eq!(statuses, ["running", "stopped", "running", "completed"]);
+}
