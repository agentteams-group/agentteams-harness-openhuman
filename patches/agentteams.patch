@@ -0,0 +1,202 @@
+//! Run-scoped controls for verified human/agent Matrix direct conversations.
+#[cfg(test)]
+#[path = "matrix_direct_tests.rs"]
+mod tests;
+use super::traits::ChannelMessage;
+use crate::openhuman::agent::harness::run_queue::{QueueMode, QueuedMessage, RunQueue};
+use crate::openhuman::inference::provider::ChatMessage;
+use matrix_sdk::Room;
+use once_cell::sync::Lazy;
+use serde_json::json;
+use std::collections::{HashMap, HashSet};
+use std::sync::{Arc, Mutex};
+use tokio_util::sync::CancellationToken;
+
+pub(crate) struct DirectRun {
+    pub id: String,
+    pub sender: String,
+    pub inputs: Vec<String>,
+    pub source_event_ids: Vec<String>,
+    pub room: Room,
+    assistant: bool,
+    pub cancel: CancellationToken,
+    pub done: CancellationToken,
+    pub queue: Arc<RunQueue>,
+    pub delivered: Mutex<Vec<String>>,
+    seen: Mutex<HashSet<String>>,
+    admission: tokio::sync::Mutex<bool>,
+    transport: Mutex<Option<tokio::sync::mpsc::Sender<ChannelMessage>>>,
+}
+
+static RUNS: Lazy<Mutex<HashMap<String, Arc<DirectRun>>>> =
+    Lazy::new(|| Mutex::new(HashMap::new()));
+static ACTIVE: Lazy<Mutex<HashMap<String, Arc<DirectRun>>>> =
+    Lazy::new(|| Mutex::new(HashMap::new()));
+
+pub(crate) fn register(
+    room: Room,
+    id: String,
+    sender: String,
+    inputs: Vec<String>,
+    source_event_ids: Vec<String>,
+) {
+    let run = Arc::new(DirectRun {
+        assistant: super::task_protocol::assistant_notification(&id),
+        id: id.clone(),
+        sender,
+        inputs,
+        source_event_ids,
+        room,
+        cancel: CancellationToken::new(),
+        done: CancellationToken::new(),
+        queue: RunQueue::new(),
+        delivered: Mutex::new(Vec::new()),
+        seen: Mutex::new(HashSet::new()),
+        admission: tokio::sync::Mutex::new(true),
+        transport: Mutex::new(None),
+    });
+    RUNS.lock().unwrap().insert(id, run);
+}
+
+pub(crate) fn get(id: &str) -> Option<Arc<DirectRun>> {
+    RUNS.lock().unwrap().get(id).cloned()
+}
+
+pub(crate) fn active(room: &str) -> Option<Arc<DirectRun>> {
+    ACTIVE.lock().unwrap().get(room).cloned()
+}
+
+pub(crate) fn current() -> Option<Arc<DirectRun>> {
+    crate::openhuman::approval::matrix::CONTEXT
+        .try_with(|context| {
+            active(&context.room)
+                .filter(|run| run.sender == context.sender && !run.done.is_cancelled())
+        })
+        .ok()
+        .flatten()
+}
+
+pub(crate) async fn delivered(
+    event: &str,
+    text: &str,
+    history: &[ChatMessage],
+) -> anyhow::Result<()> {
+    if let Some(run) = current() {
+        crate::openhuman::channels::task_recovery::checkpoint(history).await?;
+        crate::openhuman::channels::task_recovery::commit_steer(event, history).await?;
+        run.delivered.lock().unwrap().push(text.to_owned());
+    }
+    Ok(())
+}
+
+impl DirectRun {
+    pub(crate) fn set_transport(&self, tx: tokio::sync::mpsc::Sender<ChannelMessage>) {
+        *self.transport.lock().unwrap() = Some(tx);
+    }
+
+    pub(crate) async fn steer(&self, event: &str, text: &str) -> bool {
+        let open = self.admission.lock().await;
+        if !*open || self.cancel.is_cancelled() {
+            return false;
+        }
+        if !self.seen.lock().unwrap().insert(event.to_owned()) {
+            return true;
+        }
+        self.queue
+            .push(QueuedMessage {
+                text: text.to_owned(),
+                mode: QueueMode::Steer,
+                client_id: event.to_owned(),
+                thread_id: self.room.room_id().to_string(),
+                queued_at_ms: chrono::Utc::now().timestamp_millis() as u64,
+                model_override: None,
+                temperature: None,
+                profile_id: None,
+                locale: None,
+            })
+            .await;
+        true
+    }
+    pub async fn status(&self, status: &str) {
+        if self.assistant {
+            return;
+        }
+        let body = match status {
+            "running" => "正在执行",
+            "stopping" => "正在停止",
+            "stopped" => "已停止",
+            "completed" => "本轮已结束",
+            _ => "执行失败",
+        };
+        let content = json!({"msgtype": "m.notice", "body": body,
+            "com.agentteams.execution": {"run_id": self.id, "status": status,
+                "capabilities": ["stop", "steer"], "steering_mode": "native"}});
+        if let Err(error) = self.room.send_raw("m.room.message", content).await {
+            tracing::warn!("Matrix execution status delivery failed: {error}");
+        }
+    }
+
+    pub async fn start(self: &Arc<Self>) {
+        // Preserve the native room history order for ordinary follow-up input.
+        loop {
+            let previous = {
+                let mut active = ACTIVE.lock().unwrap();
+                if let Some(previous) = active.get(self.room.room_id().as_str()) {
+                    Some(previous.clone())
+                } else {
+                    active.insert(self.room.room_id().to_string(), self.clone());
+                    None
+                }
+            };
+            let Some(previous) = previous else { break };
+            previous.done.cancelled().await;
+        }
+        self.status("running").await;
+    }
+
+    pub async fn finish(&self) {
+        let mut open = self.admission.lock().await;
+        *open = false;
+        let remaining = self.queue.drain_steers().await;
+        drop(open);
+        // Managed inputs stay pending in the durable Matrix feed until their
+        // native source is committed. Ordinary installs own their local handoff.
+        if !super::task_recovery::enabled() && !self.cancel.is_cancelled() {
+            let transport = self.transport.lock().unwrap().clone();
+            if let Some(tx) = transport {
+                for message in remaining {
+                    register(
+                        self.room.clone(),
+                        message.client_id.clone(),
+                        self.sender.clone(),
+                        vec![message.text.clone()],
+                        vec![message.client_id.clone()],
+                    );
+                    if let Some(next) = get(&message.client_id) {
+                        next.set_transport(tx.clone());
+                    }
+                    let _ = tx
+                        .send(ChannelMessage {
+                            id: message.client_id,
+                            sender: self.sender.clone(),
+                            reply_target: self.room.room_id().to_string(),
+                            content: message.text,
+                            channel: "matrix".into(),
+                            timestamp: message.queued_at_ms / 1000,
+                            thread_ts: None,
+                        })
+                        .await;
+                }
+            }
+        }
+        self.status(if self.cancel.is_cancelled() {
+            "stopped"
+        } else {
+            "completed"
+        })
+        .await;
+        RUNS.lock().unwrap().remove(&self.id);
+        ACTIVE.lock().unwrap().remove(self.room.room_id().as_str());
+        self.done.cancel();
+    }
+}
