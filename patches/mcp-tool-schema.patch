+use openhuman_core::openhuman::tokenjuice::compact_tool_output;
+#[test]
+fn mcp_discovery_keeps_every_tool_schema() {
+    let tools: Vec<_> = (0..20).map(|i| serde_json::json!({"name":format!("task_tool_{i}"),"description":"Task coordination operation","input_schema":{"type":"object","properties":{"taskId":{"type":"string"},"mode":{"enum":["start_task","submit_task"]}},"required":["taskId"]}})).collect();
+    let output =
+        serde_json::to_string_pretty(&serde_json::json!({"server":"teamharness","tools":tools}))
+            .unwrap();
+    let (compacted, stats) = compact_tool_output("mcp_list_tools", None, &output, Some(0));
+    assert!(
+        !stats.applied,
+        "MCP discovery schemas must remain available to the next tool call"
+    );
+    assert_eq!(compacted, output);
+}
+#[test]
+fn shell_logs_still_compact() {
+    let output = (0..1000)
+        .map(|i| format!("build line {i}\n"))
+        .collect::<String>();
+    let (compacted, stats) = compact_tool_output("shell", None, &output, Some(0));
+    assert!(stats.applied);
+    assert!(compacted.len() < output.len());
+}
